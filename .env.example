# ---- AI (Google Gemini) ----
# Get a key at https://aistudio.google.com/apikey . Without it, CareRoute uses its deterministic rules engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- PayPal (sandbox) ----
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Without these, CareRoute runs a clearly-labelled simulated PayPal flow.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Optional: webhook ID from the PayPal dashboard, enables signature verification on /api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# ---- App ----
CURRENCY=USD
CONFIDENCE_THRESHOLD=0.6
# DATABASE_PATH=./careroute.db
# Seed demo cases on first boot when the database is empty (handy for hosted demos)
AUTO_SEED=false
